# 客户交付用 backend：含迁移脚本，无源码挂载依赖。
FROM python:3.11-slim
WORKDIR /app
COPY mosaic/server/backend/requirements.txt .
RUN pip install --no-cache-dir --progress-bar off -r requirements.txt
COPY mosaic/server/backend/app ./app
# 结构 init.sql + 种子 init-data.sql + 存量 migrations
COPY mosaic/server/db /db
ENV PYTHONUNBUFFERED=1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
