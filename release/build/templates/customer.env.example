POSTGRES_USER=mosaic
POSTGRES_PASSWORD=mosaic_secret
POSTGRES_DB=mosaic_visual
RABBITMQ_USER=mosaic
RABBITMQ_PASS=mosaic_secret
JWT_SECRET=change-me-in-production
BACKEND_PORT=8000
FRONTEND_PORT=9080
# 机器绑定许可的联网校验地址（发版台根 URL，不要带路径）。发包时写入，更换发版台再改。
LICENSE_SERVER_URL={{LICENSE_SERVER_URL}}
# 推扫拼图（FigSpec 推扫高光谱）。关闭时两行改成 PUSHBROOM_ENABLED=false、COMPOSE_PROFILES=
PUSHBROOM_ENABLED={{PUSHBROOM_ENABLED}}
COMPOSE_PROFILES={{COMPOSE_PROFILES}}
# 推扫 worker 内存：算法预算 PB_MAX_MEMORY_GB 要比容器上限 PB_MEM_LIMIT 小几 GB
# PB_MAX_MEMORY_GB=8
# PB_MEM_LIMIT=12g
# 推扫相机标定（重装相机后按部署手册重新标定再填）；不填用内置 FS-60C 标定
# PB_SENSOR_ALONG_OFFSET_M=1.7
# PB_SENSOR_BORESIGHT_PX=-19
# PB_SENSOR_SAMPLE_SIGN=-1
# 只给 worker 部分 NVIDIA 卡时填写，例如 0 或 0,1。默认 all。须配合 docker-compose.gpu.yml。
# MOSAIC_GPUS=all
# 若私有仓库另有 backend/frontend 镜像，在此覆盖（须与包内架构一致）
# BACKEND_IMAGE=spectrum-mosaic-backend:{{VERSION}}-{{ARCH}}
# FRONTEND_IMAGE=spectrum-mosaic-frontend:{{VERSION}}-{{ARCH}}
